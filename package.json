{
  "name": "investment",
  "version": "1.0.0",
  "description": "Complete analysis tool for comparing different monthly investment timing strategies across multiple years.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "build:backend": "tsc --project tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "sync": "ts-node src/index.ts sync",
    "cli": "ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:studio": "prisma studio",
    "download:futures": "tsx src/index.ts futures",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dp21g/investment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dp21g/investment/issues"
  },
  "homepage": "https://github.com/dp21g/investment#readme",
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.11",
    "yahoo-finance2": "^3.11.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lightweight-charts": "^4.2.2",
    "lucide-react": "^0.562.0",
    "pg": "^8.17.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1"
  }
}
