// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Candle {
  id            Int      @id @default(autoincrement())
  ticker        String
  date          DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  adjClose      Float?
  volume        BigInt
  
  // Pre-calculated indicators for efficient querying
  rsi           Float?
  ema20         Float?
  macd          Float?
  macdSignal    Float?
  macdHistogram Float?

  @@unique([ticker, date])
  @@index([ticker, date])
  @@index([rsi]) // Efficient search for "RSI < 40"
}

model Candle30m {
  id            Int      @id @default(autoincrement())
  ticker        String
  date          DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        BigInt

  @@unique([ticker, date])
  @@index([ticker, date])
}

model Candle3m {
  id            Int      @id @default(autoincrement())
  ticker        String
  date          DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        BigInt

  @@unique([ticker, date])
  @@index([ticker, date])
}
